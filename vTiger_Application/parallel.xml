<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Vtiger Parallel Suite"
       parallel="tests"
       thread-count="3"
       verbose="2">

    <test name="Home Tests">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="testScripts.HomeTest"/>
        </classes>
    </test>

    <test name="Calendar Tests">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="testScripts.CalendarTest"/>
        </classes>
    </test>

    <test name="Organization Tests">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="testScripts.OrganizationsTest"/>
        </classes>
    </test>

    <test name="Contact Tests">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="testScripts.ContactTest"/>
        </classes>
    </test>

    <test name="Login Tests">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="testScripts.LoginTest"/>
        </classes>
    </test>

</suite>
