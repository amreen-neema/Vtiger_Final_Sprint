<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Vtiger Cross Browser Suite" verbose="2">

    <test name="Chrome Tests">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="testScripts.LoginTest"/>
            <class name="testScripts.HomeTest"/>
            <class name="testScripts.CalendarTest"/>
            <class name="testScripts.OrganizationsTest"/>
            <class name="testScripts.ContactTest"/>
        </classes>
    </test>

    <test name="Firefox Tests">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="testScripts.LoginTest"/>
            <class name="testScripts.HomeTest"/>
            <class name="testScripts.CalendarTest"/>
            <class name="testScripts.OrganizationsTest"/>
            <class name="testScripts.ContactTest"/>
        </classes>
    </test>

</suite>
